<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to Environment.props (git-ignored) and point it at your Valheim install. -->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Folder containing valheim.exe -->
    <VALHEIM_INSTALL>C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <!-- Optional: BepInEx folder of a mod-manager profile, used for copying the built DLL -->
    <!-- <BEPINEX_PATH>C:\Users\you\AppData\Roaming\r2modmanPlus-local\Valheim\profiles\Default\BepInEx</BEPINEX_PATH> -->
    <!-- Optional: copy the built DLL into BepInEx/plugins after each build -->
    <MOD_DEPLOYPATH>$(VALHEIM_INSTALL)\BepInEx\plugins</MOD_DEPLOYPATH>
  </PropertyGroup>
</Project>
