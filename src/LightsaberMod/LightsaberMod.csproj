<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Valheim runs on Unity 6, whose assemblies are built against .NET Standard 2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LightsaberMod</AssemblyName>
    <RootNamespace>LightsaberMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Valheim ships its own copies of these; never copy them next to the mod. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- Game, Unity and BepInEx references must not be copied next to the mod. -->
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- Jotunn's package also wires up references to the game, Unity, BepInEx and Harmony
         from VALHEIM_INSTALL (see Environment.props.example). -->
    <PackageReference Include="JotunnLib" Version="2.30.2" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jotunn ships only a net462 build. NuGet won't pick it for netstandard2.1 on its own (the
         package's build props count as compatible assets), so reference it directly; netstandard2.1's
         mscorlib facade resolves its framework types. -->
    <Reference Include="Jotunn">
      <HintPath>$(PkgJotunnLib)\lib\net462\Jotunn.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(MOD_DEPLOYPATH)' != '' And Exists('$(MOD_DEPLOYPATH)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MOD_DEPLOYPATH)\LightsaberMod" />
    <Message Importance="High" Text="Deployed $(TargetFileName) to $(MOD_DEPLOYPATH)\LightsaberMod" />
  </Target>

</Project>
